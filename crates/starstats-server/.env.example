# StarStats API server — local dev configuration
#
# Copy to `.env` (gitignored) and adjust for your local setup. The
# server will pick this up via dotenvy if invoked via cargo with the
# repo root as cwd, or you can `source` it manually.
#
# Production deployment uses Docker secrets at /run/secrets/* and
# inline env vars set by your container orchestrator.

# ---- Bind ---------------------------------------------------------
# Local dev defaults to all interfaces on 8080. The Dockerfile keeps
# the same default.
STARSTATS_BIND=0.0.0.0:8080

# ---- Database -----------------------------------------------------
# Either supply a full DATABASE_URL (preferred for local dev), or
# the STARSTATS_DB_* parts and the server will compose the URL.
DATABASE_URL=postgres://starstats_app:devpassword@localhost:5432/starstats?sslmode=disable

# Compose-style alternative (uncomment if you prefer parts):
# STARSTATS_DB_HOST=localhost
# STARSTATS_DB_PORT=5432
# STARSTATS_DB_USER=starstats_app
# STARSTATS_DB_NAME=starstats
# STARSTATS_DB_PASSWORD=devpassword
# Or read the password from a file (production pattern):
# STARSTATS_DB_PASSWORD_FILE=/run/secrets/starstats_db_password

# ---- JWT issuer ---------------------------------------------------
# Required. Must match the public origin of the web app — desktop
# clients discover the JWKS at $STARSTATS_JWT_ISSUER/.well-known/jwks.json.
STARSTATS_JWT_ISSUER=http://localhost:3000

# Audience baked into every minted token's `aud` claim. Default is fine.
STARSTATS_JWT_AUDIENCE=starstats

# Path to the RSA private key PEM. The default in the Dockerfile is
# /var/lib/starstats/jwt-key.pem; for local dev anywhere writable works.
STARSTATS_JWT_KEY_FILE=./.dev-jwt-key.pem

# Allow the server to generate a fresh RSA keypair at boot when the
# file at STARSTATS_JWT_KEY_FILE is missing. Required for first-boot
# bootstrap and for local dev (this .env.example sets it true).
#
# Leave UNSET (or false) in any deployment where the key path could
# live on ephemeral storage (containers without a volume mount,
# Kubernetes pods without a PVC, etc.). A fresh keypair invalidates
# every previously-issued device + user JWT — desktop clients see
# "no longer paired" until they re-pair, web users get logged out.
#
# Accepts: 1/true/yes/on or 0/false/no/off (case-insensitive).
STARSTATS_JWT_KEY_AUTOGEN=true

# ---- TOTP Key Encryption Key (KEK) --------------------------------
# AES-256-GCM key wrapping every 2FA user's TOTP secret at rest.
# STARSTATS_KEK_FILE defaults to /var/lib/starstats/totp-kek.bin.
#
# STARSTATS_KEK_AUTOGEN works exactly like STARSTATS_JWT_KEY_AUTOGEN:
# leave UNSET (or false) in any deployment where the key path could
# live on ephemeral storage. A fresh KEK CANNOT decrypt existing TOTP
# secrets, so every 2FA-enrolled user is locked out of second-factor
# verification until an admin resets their enrolment.
#
# Accepts: 1/true/yes/on or 0/false/no/off (case-insensitive).
STARSTATS_KEK_AUTOGEN=true

# ---- Contract ingest (sp-ingest push) ----------------------------
# Shared static bearer token for POST /api/contracts/ingest. Paste the
# SAME value into sp-ingest's /settings page (starstats_token). When
# unset, the ingest endpoint returns 503 not_configured — the public
# /api/contracts read routes still work regardless.
#
# Accepts an inline value here OR a docker-secret mount via
# STARSTATS_INGEST_TOKEN_FILE (same convention as the DB password /
# SpiceDB / Revolut secrets). Inline wins when both are set.
# STARSTATS_INGEST_TOKEN=change-me-to-a-long-random-token
# STARSTATS_INGEST_TOKEN_FILE=/run/secrets/starstats_ingest_token

# ---- Logging ------------------------------------------------------
# Standard tracing-subscriber filter. The default in code is
# "info,starstats=debug,sqlx=warn,tower_http=debug" if unset.
# RUST_LOG=info,starstats=debug,sqlx=warn
