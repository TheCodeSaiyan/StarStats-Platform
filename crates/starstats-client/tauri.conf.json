{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarStats",
  "version": "0.1.8",
  "identifier": "app.starstats.tray",
  "build": {
    "beforeDevCommand": "pnpm --filter tray-ui dev",
    "beforeBuildCommand": "pnpm --filter tray-ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../apps/tray-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "StarStats",
        "width": 900,
        "height": 640,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https:",
      "devCsp": "default-src 'self'; img-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:5173 ws://localhost:5173 http://localhost:* https://localhost:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "StarStats",
    "category": "Utility",
    "shortDescription": "Personal Star Citizen metrics",
    "longDescription": "EAC-safe local capture of personal Star Citizen game stats. Reads only Game.log and authenticated robertsspaceindustries.com pages.",
    "windows": {
      "wix": {
        "fragmentPaths": [
          "wix/upgrade_metadata.wxs"
        ]
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/TheCodeSaiyan/StarStats-Platform/main/release-manifests/tray-live.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1MURBOUU0NDZFQkMwMApSV1FBdkc1RW50cFJBdllaQVFoNSttSm82bFl6dnNMNXQrUFlFUFNYN2ZqNVZDdDR4VTR0WjJPawo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
