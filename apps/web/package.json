    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.74.0",
    "api-client-ts": "workspace:*",
    "design-tokens": "workspace:*",
    "holo": "workspace:*",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
