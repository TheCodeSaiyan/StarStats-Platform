# Reference-only Komodo credential profile for `op run --env-file`.
#
# The host is public configuration. Keep the real API key and secret in
# 1Password. The local profile at %USERPROFILE%\.codex\komodo.env should
# contain op:// credential references, not resolved values.
KOMODO_CLI_HOST=https://komodo.example.com
KOMODO_CLI_KEY=op://<vault>/<item>/<key-field>
KOMODO_CLI_SECRET=op://<vault>/<item>/<secret-field>

# Local guard used by StarStats validation instructions; not a Komodo secret.
STARSTATS_KOMODO_STACK=starstats
